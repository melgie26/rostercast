# Set these on the Node hosting service, never in browser files or GitHub.
NODE_ENV=production
APP_ORIGIN=https://your-rostercast-domain.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_KEY_HEX=replace_with_64_hex_characters
PORT=3000

# Set these on the Node hosting service, never in browser files or GitHub.
NODE_ENV=production
APP_ORIGIN=https://your-rostercast-domain.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_KEY_HEX=replace_with_64_hex_characters
# Airdrie Google Workspace access. Keep the private key in hosted secrets.
GOOGLE_WORKSPACE_DOMAIN=airdriefirefighters.com
GOOGLE_EXECUTIVE_GROUP=exec@airdriefirefighters.com
GOOGLE_STEWARD_GROUP=stewards@airdriefirefighters.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=rostercast-directory@your-google-cloud-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"
GOOGLE_WORKSPACE_ADMIN_EMAIL=workspace-admin@airdriefirefighters.com
PORT=3000
